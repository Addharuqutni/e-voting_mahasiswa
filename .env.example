# Default: SQLite file next to the Prisma schema (no DB process to run).
DATABASE_URL="file:./pemira.db"
# PostgreSQL alternative (managed DB / another host):
# DATABASE_URL="postgresql://user:pass@host:5432/pemira?connection_limit=8&connect_timeout=10&pool_timeout=20&socket_timeout=30"
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Berapa pemilih yang boleh di dalam bilik suara sekaligus (sisanya antre).
MAX_ACTIVE_VOTERS=100

# Batas percobaan login (anti brute force). Per-IP dibuat longgar untuk NAT kampus.
LOGIN_LIMIT_PER_IP=200
LOGIN_LIMIT_PER_ACCOUNT=8
